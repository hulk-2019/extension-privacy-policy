# ===== 流式音乐播放 =====
# 阿里云 OSS 音频文件的完整公网 URL。留空则使用内置演示曲目。
# 不要填写 your-bucket / path/to/music 这类占位地址，部署后会 403。
AUDIO_OSS_URL=

# 可选：LRC 歌词文件的完整公网 URL
AUDIO_LRC_URL=

# 可选：允许通过 /api/stream?url=<完整地址> 动态指定音频源的主机白名单（逗号分隔）。
# 留空则禁用 ?url= 方式（推荐，避免服务被当作开放代理 / SSRF）。
AUDIO_ALLOWED_HOSTS=

# 可选：上游未返回 Content-Type 时的兜底值
AUDIO_CONTENT_TYPE=audio/mpeg
